# Copy this file to .env and fill in your own Supabase project's values.
# Get both from: Supabase dashboard -> your project -> Project Settings -> API

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The "service_role" key (NOT the "anon" key) — this server-side app is the
# only thing that talks to Supabase, so it needs full read/write access.
# Never expose this key to the browser/frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

PORT=3000

# Optional, comma-separated. Anyone who signs up with one of these emails is
# auto-approved as admin (skips the pending queue entirely) — this is how
# the very first admin, or any test admin accounts, get created without
# touching SQL. Remove/leave unset once your school's real admins are set
# up, so this isn't a standing door.
ADMIN_BOOTSTRAP_EMAILS=headteacher@example.org,test-admin@example.org

# Optional. Turns on "Generate with AI" in Teacher Admin's question-set
# builder (a draft-questions wizard, useful for SEN pupils — describe the
# level and it writes in plain, unambiguous language). Without this set,
# that panel just shows a "not set up yet" message and question sets are
# written by hand as before. Get a key at https://console.anthropic.com
# (Settings -> API Keys) — this is a separate account/billing relationship
# from any Claude subscription, and calls to it are billed per use.
ANTHROPIC_API_KEY=

# Optional. Defaults to a cost-efficient model (claude-haiku-4-5-20251001)
# if unset — only set this if you want a different model to draft questions.
ANTHROPIC_MODEL=
