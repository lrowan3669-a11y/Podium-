# Copy this file to .env and fill in your own Supabase project's values.
# Get both from: Supabase dashboard -> your project -> Project Settings -> API

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The "service_role" key (NOT the "anon" key) — this server-side app is the
# only thing that talks to Supabase, so it needs full read/write access.
# Never expose this key to the browser/frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

PORT=3000

# Optional, comma-separated. Anyone who signs up with one of these emails is
# auto-approved as admin (skips the pending queue entirely) — this is how
# the very first admin, or any test admin accounts, get created without
# touching SQL. Remove/leave unset once your school's real admins are set
# up, so this isn't a standing door.
ADMIN_BOOTSTRAP_EMAILS=headteacher@example.org,test-admin@example.org
